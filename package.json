{
  "name": "mypwaindia-react",
  "private": false,
  "version": "6.9.67",
  "type": "module",
  "author": "exerinity <me@exerinity.com>",
  "license": "MIT",
  "description": "MyPayIndia responsive web app",
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "build:watch": "vite build --watch",
    "build:single": "vite build --config vite.config.minify.js",
    "build:all": "vite build && vite build --config vite.config.minify.js",
    "preview": "vite preview",
    "preview:fresh": "vite build && vite preview",
    "preview:single": "vite preview --config vite.config.minify.js",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vite build",
    "check:chunks": "vite build && node scripts/check-chunks.mjs",
    "worker:dev": "vite build && wrangler dev",
    "worker:logs": "wrangler tail",
    "deploy:dry": "tsc --noEmit && vite build && wrangler deploy --dry-run",
    "deploy": "tsc --noEmit && vite build && wrangler deploy"
  },
  "dependencies": {
    "@twemoji/api": "^17.0.3",
    "@types/three": "^0.185.1",
    "fluid-player": "^3.60.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-globe.gl": "^2.38.0",
    "react-router-dom": "^6.26.0",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^0.21.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
